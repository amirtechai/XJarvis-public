# ============================================================================
# XJarvis — environment configuration
# ============================================================================
# Copy this file to  backend/.env  and fill ONLY the keys you actually use.
# Every key is OPTIONAL: a missing key gracefully disables that one feature
# without breaking the rest of the system. NOTHING here ships with a value —
# each user provides their own keys (see README → "Ayarlar / Settings").
#
#   cp .env.example backend/.env
#   # then edit backend/.env  (or use the in-app Settings → Keys page)
#
# NEVER commit backend/.env — it is git-ignored on purpose.
# ============================================================================

# ── LLM provider ────────────────────────────────────────────────────────────
# provider seçimi: ollama (yerel, ücretsiz) | claude | groq | gemini | together
# Claude, Anthropic aboneliği/Agent SDK ile çalışır (API key GEREKMEZ):
#   npx @anthropic-ai/claude-code  → /login  → sonra:
#   claude setup-token   → çıkan token'ı CLAUDE_CODE_OAUTH_TOKEN'a koy
LLM_PROVIDER=ollama
LLM_DEFAULT=
LLM_HEAVY=
LLM_FREE=
LLM_DAILY_CAP_USD=2.00
CLAUDE_CODE_OAUTH_TOKEN=

# Alternatif LLM sağlayıcı anahtarları (LLM_PROVIDER'a göre biri gerekir)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=

# ── Ses: konuşma tanıma (STT) ───────────────────────────────────────────────
# Deepgram bulut STT (opsiyonel). Boşsa yerel Whisper'a düşer.
DEEPGRAM_API_KEY=
GROQ_STT_MODEL=
WHISPER_LOCAL_FALLBACK=true
WHISPER_WAKE_MODEL=
STT_LANGUAGE=tr
STT_SPEECH_RMS=
STT_SILENCE_END_MS=
STT_MAX_UTTERANCE_S=
STT_NO_SPEECH_ABORT_S=

# ── Ses: seslendirme (TTS) ──────────────────────────────────────────────────
# Boşsa macOS yerel `say` sesi kullanılır (ücretsiz).
# ElevenLabs premium ses (opsiyonel) — kendi anahtar/ses kimliğini gir:
XJARVIS_TTS_BACKEND=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_ID=
MACOS_TTS_VOICE=
VOICE_TTS_PORT=8766
VOICE_TTS_TAIL_S=
VOICE_FOLLOWUP_WINDOW_S=
# Yerel VoiceBox TTS sunucusu (opsiyonel)
VOICEBOX_HOST=
VOICEBOX_PORT=
VOICEBOX_CLIENT_ID=
VOICEBOX_PROFILE_ID=
VOICEBOX_LANGUAGE=

# ── Wake word ("Jarvis" ile uyandırma) ──────────────────────────────────────
# Picovoice konsolundan ücretsiz anahtar + kendi .ppn dosyanı üret:
#   https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=
WAKE_WORD_PATH=
WAKE_ENGINE=
WAKE_MODEL=
WAKE_INFERENCE=
WAKE_THRESHOLD=
WAKE_GAIN=
WAKE_KW_RMS=
WAKE_DEBUG_SCORE=
WAKE_KEYWORDS_ENABLED=
WAKE_WORD_ENABLED=
WAKE_GREETING_ENABLED=

# ── Görü (kamera / vision) ──────────────────────────────────────────────────
VISION_MODEL=
CAMERA_INDEX=0
VISION_MJPEG_PORT=8765

# ── Telegram botu (uzaktan komut + günlük brifing) ──────────────────────────
# @BotFather → /newbot → token. chat_id'ni almak için:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
XJARVIS_TG_REMOTE=0

# ── Kişilik / dil ───────────────────────────────────────────────────────────
XJARVIS_LANG=tr
XJARVIS_PERSONA=
XJARVIS_PERSONA_HINT=
# WhatsApp sahibi (opsiyonel) — kendi numaran / JID'in
XJARVIS_OWNER_PHONE=
XJARVIS_OWNER_JID=

# ── Uzak sunucu / companion (opsiyonel) ─────────────────────────────────────
# Kendi alan adında web companion çalıştırıyorsan:
XJARVIS_SERVER_URL=
XJARVIS_SHARED_TOKEN=
COMPANION_ORIGIN=
XJARVIS_EXEC_TOKEN=

# ── Servis portları ─────────────────────────────────────────────────────────
JARVIS_BUS_URL=ws://localhost:3001
AGENT_PORT=8767
AGENT_MAX_ITER=8

# ── Hava durumu widget'ı (varsayılan İstanbul; kendi konumunu gir) ──────────
WEATHER_LATITUDE=41.0082
WEATHER_LONGITUDE=28.9784
WEATHER_TIMEZONE=Europe/Istanbul
OPENWEATHER_API_KEY=

# ── Entegrasyonlar (hepsi opsiyonel — kullandığını doldur) ──────────────────
# Google (Gmail/Takvim/Drive) — kendi OAuth istemcini oluştur
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_EXPIRES_AT=
GOOGLE_USER_EMAIL=
GOOGLE_USER_EMAIL_VERIFIED=
# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_TOKEN_EXPIRES_AT=
# GitHub
GITHUB_TOKEN=
XJARVIS_REPO=amirtechai/XJarvis-public
GITHUB_FEED_OWNER=
NPM_TOKEN=
# Notion / Atlassian / Linear
NOTION_API_KEY=
ATLASSIAN_API_TOKEN=
ATLASSIAN_EMAIL=
ATLASSIAN_CLOUD_URL=
ATLASSIAN_ORG_ID=
LINEAR_API_KEY=
# Reddit / Facebook
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LONG_TOKEN=
# Diğer
STITCH_TOKEN=
HUNTER_API_KEY=

# ── Web arama (opsiyonel — biri yeterli) ────────────────────────────────────
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=

# ── Finans / piyasa verisi (opsiyonel) ──────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
BINANCE_API_KEY=
BINANCE_SECRET=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=
NEWSAPI_KEY=
FOOTBALL_DATA_API_KEY=
AVIATIONSTACK_API_KEY=
YOUTUBE_API_KEY=

# ── Medya üretimi (opsiyonel) ───────────────────────────────────────────────
FAL_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ── OpenJarvis köprüsü (opsiyonel, ayrı repo) ───────────────────────────────
# Eski OpenJarvis Python motorunu kullanacaksan kaynak yolunu ver; boşsa
# XJarvis kendi yerleşik agent'ını (agent/) kullanır.
OPENJARVIS_SRC=

# ── Özellik bayrakları ──────────────────────────────────────────────────────
ENABLE_VISION=false
ENABLE_WAKE_WORD=false
ENABLE_ROOM_TEMP=false
BARGE_IN_ENABLED=false
LOG_LEVEL=info
